{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "42rem",
      "wideSize": "72rem"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "ink", "name": "Anthrazit", "color": "#1f2124" },
        { "slug": "iron", "name": "Eisengrau", "color": "#43484e" },
        { "slug": "steel", "name": "Stahlgrau", "color": "#6b7178" },
        { "slug": "mist", "name": "Warmgrau", "color": "#e8e6e1" },
        { "slug": "paper", "name": "Warmweiss", "color": "#faf9f7" },
        { "slug": "brass", "name": "Messing", "color": "#a8763e" },
        { "slug": "brass-dark", "name": "Messing dunkel", "color": "#8a5f30" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Überschriften",
          "fontFamily": "'Fraunces', Georgia, serif"
        },
        {
          "slug": "body",
          "name": "Fliesstext",
          "fontFamily": "'Inter', 'Segoe UI', system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Klein", "size": "0.9rem" },
        { "slug": "medium", "name": "Normal", "size": "1.05rem" },
        { "slug": "large", "name": "Gross", "size": "1.4rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Titel", "size": "2.2rem", "fluid": { "min": "1.8rem", "max": "2.6rem" } },
        { "slug": "xx-large", "name": "Hero", "size": "3.2rem", "fluid": { "min": "2.3rem", "max": "3.8rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "xs", "name": "XS", "size": "0.5rem" },
        { "slug": "sm", "name": "S", "size": "0.75rem" },
        { "slug": "md", "name": "M", "size": "1.25rem" },
        { "slug": "lg", "name": "L", "size": "2rem" },
        { "slug": "xl", "name": "XL", "size": "3.25rem" },
        { "slug": "xxl", "name": "XXL", "size": "5rem" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--brass)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--brass-dark)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--brass)",
          "text": "var(--wp--preset--color--paper)"
        },
        "border": { "radius": "4px" },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--brass-dark)" }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
