{
  "name": "webforge-konfigurator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WebForge Konfigurator – gemeinsame Plattform für Geländer, Gartentore und Fenstergitter",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:wp": "tsc --noEmit && vite build --mode embed",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
