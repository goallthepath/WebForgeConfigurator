# Lokale Entwicklungsumgebung – Beispielwerte.
# Kopieren nach .env und bei Bedarf anpassen. NIEMALS echte Produktionswerte eintragen.

# Kinder-Erklärung: Das ist ein Zettel mit Geheimzahlen und
# Einstellungen für die Docker-Kisten. Diese Datei ist nur das
# Muster; die echte Kopie heisst .env und wird nie eingepackt.
# 🤧 Schnupfspruch: Passwort «dev_only» isch wie en Hustürschlüssel us Schoggi –
#    für d Übig guet, für de Ernschtfall z molli.

# Datenbank (nur lokal, keine Geheimnisse)
# Wie das Gedächtnis (die Datenbank) heisst.
DB_NAME=webforge
# Der Benutzername, mit dem WordPress in die Datenbank darf.
DB_USER=webforge
# Sein Passwort – hier absichtlich ein einfaches Übungs-Passwort.
DB_PASSWORD=webforge_dev_only
# Das Passwort für den Chef (root) der Datenbank, ebenfalls nur zum Üben.
DB_ROOT_PASSWORD=root_dev_only

# Kinder-Erklärung: Einstellungen für die WordPress-Kiste.
# WordPress
# Die Türnummer im Browser: http://localhost:8080
WP_PORT=8080
# «local» heisst: Wir üben zu Hause – dann fängt Mailpit alle Mails ab.
WP_ENVIRONMENT_TYPE=local

# 🤧 Schnupfspruch: Es Briefli im Chaschte, es Portli im Huus –
#    Mailpit list alles, und kei Mail gaht us.
# Mailpit (lokaler E-Mail-Test)
# Die Türnummer, hinter der man die abgefangenen Mails anschauen kann.
MAILPIT_UI_PORT=8025
